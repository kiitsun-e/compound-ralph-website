---
import '../styles/custom.css';

const title = 'Compound Ralph';
const description = 'Autonomous feature implementation combining rich planning with self-correcting code generation.';
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@600;700&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="landing">
	<!-- Scanning line effect -->
	<div class="scan-line" aria-hidden="true"></div>
	<!-- Data stream particles -->
	<div class="data-stream" aria-hidden="true"></div>
	<main class="landing-main">
		<section class="hero">
			<div class="hero-content">
				<h1 class="hero-title">
					<span class="hero-name">Compound Ralph</span>
				</h1>
				<p class="hero-tagline">
					Fire-and-forget feature implementation.<br />
					Plan rich. Build autonomous.
				</p>

				<div class="hero-buttons">
					<a href="/getting-started" class="btn btn-primary">Get Started</a>
					<a href="https://github.com/kiitsun-e/compound-ralph" class="btn btn-secondary" target="_blank" rel="noopener">
						GitHub
					</a>
				</div>
			</div>
			<div class="hero-visual" aria-hidden="true">
				<div class="hero-terminal">
					<div class="terminal-header">
						<span class="terminal-dot"></span>
						<span class="terminal-dot"></span>
						<span class="terminal-dot"></span>
					</div>
					<div class="terminal-body">
						<div class="terminal-line">
							<span class="terminal-prompt">$</span>
							<span class="terminal-cmd">cr implement</span>
							<span class="terminal-cursor"></span>
						</div>
					</div>
				</div>
				<div class="hero-glyph-container">
					<div class="hero-glyph">
						<span class="glyph-bracket">[</span>
						<span class="glyph-symbol">⟳</span>
						<span class="glyph-bracket">]</span>
						<span class="glyph-status"></span>
					</div>
					<div class="glyph-ring glyph-ring-inner"></div>
					<div class="glyph-ring glyph-ring-outer"></div>
					<div class="glyph-particles">
						<span class="particle"></span>
						<span class="particle"></span>
						<span class="particle"></span>
						<span class="particle"></span>
						<span class="particle"></span>
						<span class="particle"></span>
					</div>
				</div>
				<div class="hero-orbit"></div>
			</div>
		</section>

		<section class="features">
			<div class="feature feature-primary">
				<div class="feature-border"></div>
				<div class="feature-icon">
					<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M16 2L2 9L16 16L30 9L16 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
						<path d="M2 23L16 30L30 23" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
						<path d="M2 16L16 23L30 16" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
					</svg>
				</div>
				<span class="feature-number">01</span>
				<h3 class="feature-title">Rich Planning</h3>
				<p class="feature-desc">Human-guided specs with parallel research agents. Every feature starts with deep understanding.</p>
				<div class="feature-glow"></div>
			</div>
			<div class="feature feature-secondary">
				<div class="feature-border"></div>
				<div class="feature-icon">
					<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
						<circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="2"/>
						<path d="M16 8V16L22 22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</div>
				<span class="feature-number">02</span>
				<h3 class="feature-title">Autonomous Building</h3>
				<p class="feature-desc">The Ralph Loop executes one task per iteration with continuous backpressure for self-correction.</p>
				<div class="feature-glow"></div>
			</div>
			<div class="feature feature-tertiary">
				<div class="feature-border"></div>
				<div class="feature-icon">
					<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M6 12L16 4L26 12V28H6V12Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
						<path d="M12 28V18H20V28" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
						<circle cx="16" cy="11" r="2" fill="currentColor"/>
					</svg>
				</div>
				<span class="feature-number">03</span>
				<h3 class="feature-title">Compounding Learnings</h3>
				<p class="feature-desc">Context persists across iterations. Patterns and fixes accumulate, making each run smarter.</p>
				<div class="feature-glow"></div>
			</div>
		</section>

		<!-- Decorative code snippets floating -->
		<div class="floating-code" aria-hidden="true">
			<div class="code-snippet code-1">const ralph = new Compound();</div>
			<div class="code-snippet code-2">await feature.ship();</div>
			<div class="code-snippet code-3">loop.iterate();</div>
		</div>

		<!-- Bold statement section -->
		<section class="statement">
			<div class="statement-line"></div>
			<blockquote class="statement-quote">
				"Ship features, not prompts."
			</blockquote>
			<div class="statement-line"></div>
		</section>
	</main>
</body>
</html>

<style>
	/* Entrance animations */
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fadeInScale {
		from {
			opacity: 0;
			transform: scale(0.9);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes orbitSpin {
		from {
			transform: rotate(-15deg);
		}
		to {
			transform: rotate(345deg);
		}
	}

	@keyframes gradientShift {
		0%, 100% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
	}

	@keyframes scanline {
		0% {
			transform: translateY(-100vh);
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		90% {
			opacity: 1;
		}
		100% {
			transform: translateY(100vh);
			opacity: 0;
		}
	}

	@keyframes dataStream {
		0% {
			background-position: 0% 0%;
		}
		100% {
			background-position: 0% 100%;
		}
	}

	/* Landing page specific styles */
	.landing {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		background:
			/* Gradient mesh - ambient glow spots */
			radial-gradient(
				ellipse 80% 60% at 15% 20%,
				rgba(0, 229, 255, 0.08) 0%,
				transparent 50%
			),
			radial-gradient(
				ellipse 60% 80% at 85% 75%,
				rgba(0, 255, 159, 0.06) 0%,
				transparent 45%
			),
			radial-gradient(
				ellipse 50% 40% at 60% 40%,
				rgba(0, 229, 255, 0.04) 0%,
				transparent 40%
			),
			var(--landing-bg, #0a0f0d);
		color: var(--landing-text, #e0f2e9);
		font-family: 'Outfit', sans-serif;
		position: relative;
		overflow-x: hidden;
	}

	/* Tech grid pattern overlay */
	.landing::after {
		content: '';
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image:
			linear-gradient(rgba(0, 229, 255, 0.02) 1px, transparent 1px),
			linear-gradient(90deg, rgba(0, 229, 255, 0.02) 1px, transparent 1px);
		background-size: 60px 60px;
		pointer-events: none;
		z-index: 0;
		mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 70%);
		-webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 70%);
	}

	/* Subtle noise texture overlay for depth */
	.landing::before {
		content: '';
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
		opacity: 0.025;
		pointer-events: none;
		z-index: 0;
	}

	/* Scanning line effect */
	.scan-line {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 4px;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(0, 229, 255, 0.3),
			rgba(0, 255, 159, 0.5),
			rgba(0, 229, 255, 0.3),
			transparent
		);
		box-shadow: 0 0 20px rgba(0, 229, 255, 0.5), 0 0 40px rgba(0, 255, 159, 0.3);
		animation: scanline 8s ease-in-out infinite;
		pointer-events: none;
		z-index: 100;
	}

	/* Data stream effect - vertical lines */
	.data-stream {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: repeating-linear-gradient(
			0deg,
			transparent,
			transparent 98%,
			rgba(0, 229, 255, 0.03) 98%,
			rgba(0, 229, 255, 0.03) 100%
		);
		background-size: 100% 200px;
		animation: dataStream 20s linear infinite;
		pointer-events: none;
		z-index: 0;
		opacity: 0.5;
	}

	.landing-main {
		max-width: 1000px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
		position: relative;
		z-index: 1;
	}

	/* Hero section - asymmetric layout */
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		margin-bottom: 5rem;
		text-align: left;
	}

	.hero-content {
		position: relative;
		z-index: 1;
	}

	.hero-title {
		margin: 0 0 1.75rem 0;
		font-size: 4.5rem;
		font-weight: 700;
		font-family: 'JetBrains Mono', monospace;
		letter-spacing: -0.04em;
		line-height: 1;
		opacity: 0;
		animation: fadeInUp 0.6s ease-out forwards;
		text-shadow:
			0 0 80px rgba(0, 229, 255, 0.15),
			0 0 120px rgba(0, 255, 159, 0.1);
		position: relative;
	}

	/* Glitch flicker effect */
	.hero-title::before {
		content: 'Compound Ralph';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--landing-accent, #00e5ff), var(--landing-accent-green, #00ff9f), var(--landing-accent, #00e5ff));
		background-size: 200% 200%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: gradientShift 8s ease infinite, glitchFlicker 6s ease-in-out infinite;
		clip-path: inset(0 0 0 0);
	}

	@keyframes glitchFlicker {
		0%, 97%, 100% {
			clip-path: inset(0 0 0 0);
			transform: translateX(0);
		}
		97.5% {
			clip-path: inset(0 0 50% 0);
			transform: translateX(-2px);
		}
		98% {
			clip-path: inset(50% 0 0 0);
			transform: translateX(2px);
		}
		98.5% {
			clip-path: inset(0 0 0 0);
			transform: translateX(0);
		}
	}

	.hero-name {
		background: linear-gradient(135deg, var(--landing-accent, #00e5ff), var(--landing-accent-green, #00ff9f), var(--landing-accent, #00e5ff));
		background-size: 200% 200%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: gradientShift 8s ease infinite;
	}

	.hero-tagline {
		font-size: 1.375rem;
		line-height: 1.5;
		color: var(--landing-muted, #6b8f7a);
		margin: 0 0 2.5rem 0;
		max-width: 28ch;
		font-weight: 400;
		opacity: 0;
		animation: fadeInUp 0.6s ease-out forwards;
		animation-delay: 0.15s;
	}

	.hero-buttons {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		opacity: 0;
		animation: fadeInUp 0.6s ease-out forwards;
		animation-delay: 0.3s;
	}

	/* Hero visual element */
	.hero-visual {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 180px;
		opacity: 0;
		animation: fadeInScale 0.8s ease-out forwards;
		animation-delay: 0.2s;
	}

	.hero-glyph-container {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 220px;
		height: 220px;
	}

	.hero-glyph {
		font-family: 'JetBrains Mono', monospace;
		font-size: 4rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		position: relative;
		z-index: 3;
	}

	.glyph-bracket {
		color: var(--landing-muted, #6b8f7a);
		opacity: 0.6;
	}

	.glyph-symbol {
		background: linear-gradient(135deg, var(--landing-accent, #00e5ff), var(--landing-accent-green, #00ff9f));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: symbolPulse 3s ease-in-out infinite;
	}

	@keyframes symbolPulse {
		0%, 100% { filter: brightness(1); }
		50% { filter: brightness(1.3) drop-shadow(0 0 10px rgba(0, 229, 255, 0.6)); }
	}

	/* Inner glowing ring */
	.glyph-ring {
		position: absolute;
		border-radius: 50%;
		border: 2px solid transparent;
	}

	.glyph-ring-inner {
		width: 140px;
		height: 140px;
		border-color: rgba(0, 229, 255, 0.3);
		background: radial-gradient(circle at center, rgba(0, 229, 255, 0.05) 0%, transparent 70%);
		animation: ringPulse 4s ease-in-out infinite;
	}

	.glyph-ring-outer {
		width: 190px;
		height: 190px;
		border-style: dashed;
		border-color: rgba(0, 255, 159, 0.2);
		animation: orbitSpin 20s linear infinite reverse;
	}

	@keyframes ringPulse {
		0%, 100% {
			transform: scale(1);
			opacity: 1;
		}
		50% {
			transform: scale(1.05);
			opacity: 0.7;
		}
	}

	/* Floating particles */
	.glyph-particles {
		position: absolute;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.particle {
		position: absolute;
		width: 4px;
		height: 4px;
		background: var(--landing-accent, #00e5ff);
		border-radius: 50%;
		box-shadow: 0 0 8px var(--landing-accent, #00e5ff);
	}

	.particle:nth-child(1) {
		top: 10%;
		left: 50%;
		animation: float 6s ease-in-out infinite;
	}

	.particle:nth-child(2) {
		top: 30%;
		right: 5%;
		width: 3px;
		height: 3px;
		background: var(--landing-accent-green, #00ff9f);
		box-shadow: 0 0 8px var(--landing-accent-green, #00ff9f);
		animation: float 5s ease-in-out infinite 0.5s;
	}

	.particle:nth-child(3) {
		bottom: 15%;
		right: 15%;
		animation: float 7s ease-in-out infinite 1s;
	}

	.particle:nth-child(4) {
		bottom: 25%;
		left: 10%;
		width: 3px;
		height: 3px;
		background: var(--landing-accent-green, #00ff9f);
		box-shadow: 0 0 8px var(--landing-accent-green, #00ff9f);
		animation: float 5.5s ease-in-out infinite 1.5s;
	}

	.particle:nth-child(5) {
		top: 40%;
		left: 0%;
		animation: float 6.5s ease-in-out infinite 2s;
	}

	.particle:nth-child(6) {
		top: 60%;
		right: 0%;
		width: 2px;
		height: 2px;
		animation: float 5s ease-in-out infinite 2.5s;
	}

	@keyframes float {
		0%, 100% {
			transform: translateY(0) translateX(0);
			opacity: 0.4;
		}
		25% {
			transform: translateY(-10px) translateX(5px);
			opacity: 1;
		}
		50% {
			transform: translateY(-5px) translateX(-5px);
			opacity: 0.6;
		}
		75% {
			transform: translateY(-15px) translateX(3px);
			opacity: 0.9;
		}
	}

	.hero-orbit {
		position: absolute;
		width: 200px;
		height: 200px;
		border: 1px dashed rgba(0, 229, 255, 0.2);
		border-radius: 50%;
		animation: orbitSpin 30s linear infinite;
	}

	/* Terminal element - Compound Ralph signature */
	.hero-terminal {
		position: absolute;
		top: -20px;
		left: 50%;
		transform: translateX(-50%);
		background: rgba(10, 15, 13, 0.9);
		border: 1px solid rgba(0, 229, 255, 0.2);
		border-radius: 6px;
		padding: 0;
		width: 180px;
		font-family: 'JetBrains Mono', monospace;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
		overflow: hidden;
	}

	.terminal-header {
		display: flex;
		gap: 4px;
		padding: 6px 8px;
		background: rgba(0, 229, 255, 0.05);
		border-bottom: 1px solid rgba(0, 229, 255, 0.1);
	}

	.terminal-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: rgba(0, 229, 255, 0.3);
	}

	.terminal-dot:first-child {
		background: rgba(255, 95, 87, 0.6);
	}

	.terminal-dot:nth-child(2) {
		background: rgba(255, 189, 46, 0.6);
	}

	.terminal-dot:last-child {
		background: rgba(40, 205, 65, 0.6);
	}

	.terminal-body {
		padding: 8px 10px;
	}

	.terminal-line {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.75rem;
	}

	.terminal-prompt {
		color: var(--landing-accent-green, #00ff9f);
	}

	.terminal-cmd {
		color: var(--landing-text, #e0f2e9);
	}

	@keyframes blink {
		0%, 50% { opacity: 1; }
		51%, 100% { opacity: 0; }
	}

	.terminal-cursor {
		width: 6px;
		height: 12px;
		background: var(--landing-accent, #00e5ff);
		animation: blink 1s step-end infinite;
	}

	/* Status indicator - shows agent is "alive" */
	.glyph-status {
		position: absolute;
		top: -4px;
		right: -12px;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--landing-accent-green, #00ff9f);
		box-shadow: 0 0 8px var(--landing-accent-green, #00ff9f);
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% {
			transform: scale(1);
			opacity: 1;
		}
		50% {
			transform: scale(1.2);
			opacity: 0.7;
		}
	}

	/* Buttons */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 1rem 2rem;
		font-size: 0.9375rem;
		font-weight: 600;
		font-family: 'JetBrains Mono', monospace;
		text-decoration: none;
		border-radius: 10px;
		position: relative;
		cursor: pointer;
		letter-spacing: -0.01em;
		transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
					box-shadow 0.25s ease,
					background 0.25s ease,
					border-color 0.25s ease;
	}

	.btn:hover {
		transform: translateY(-3px);
	}

	.btn:active {
		transform: translateY(-1px) scale(0.98);
		transition-duration: 0.05s;
	}

	/* Primary button - gradient with shine effect */
	.btn-primary {
		background: linear-gradient(
			135deg,
			var(--landing-accent, #00e5ff) 0%,
			var(--landing-accent-green, #00ff9f) 100%
		);
		color: var(--landing-bg, #0a0f0d);
		border: none;
		box-shadow:
			0 4px 16px rgba(0, 229, 255, 0.35),
			0 0 0 1px rgba(255, 255, 255, 0.1) inset,
			inset 0 2px 0 rgba(255, 255, 255, 0.25);
		overflow: hidden;
		text-shadow: 0 1px 1px rgba(0, 0, 0, 0.1);
		position: relative;
	}

	/* Pulsing ring effect on primary button */
	.btn-primary::after {
		content: '';
		position: absolute;
		inset: -4px;
		border: 2px solid rgba(0, 229, 255, 0.4);
		border-radius: 14px;
		opacity: 0;
		animation: btnPulse 3s ease-in-out infinite;
	}

	@keyframes btnPulse {
		0%, 100% {
			opacity: 0;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.02);
		}
	}

	/* Shine sweep effect */
	.btn-primary::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			90deg,
			transparent 0%,
