---
import '../styles/custom.css';

const title = 'Ralph Borg';
const description = 'Autonomous feature implementation combining rich planning with self-correcting code generation.';
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@600;700&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="landing">
	<main class="landing-main">
		<section class="hero">
			<div class="hero-content">
				<h1 class="hero-title">
					<span class="hero-name">Ralph Borg</span>
				</h1>
				<p class="hero-tagline">
					Fire-and-forget feature implementation.<br />
					Plan rich. Build autonomous.
				</p>

				<div class="hero-buttons">
					<a href="/getting-started" class="btn btn-primary">Get Started</a>
					<a href="https://github.com/yourusername/ralph-borg" class="btn btn-secondary" target="_blank" rel="noopener">
						GitHub
					</a>
				</div>
			</div>
			<div class="hero-visual" aria-hidden="true">
				<div class="hero-glyph">
					<span class="glyph-bracket">[</span>
					<span class="glyph-symbol">⟳</span>
					<span class="glyph-bracket">]</span>
				</div>
				<div class="hero-orbit"></div>
			</div>
		</section>

		<section class="features">
			<div class="feature feature-primary">
				<span class="feature-number">01</span>
				<h3 class="feature-title">Rich Planning</h3>
				<p class="feature-desc">Human-guided specs with parallel research agents. Every feature starts with deep understanding.</p>
			</div>
			<div class="feature feature-secondary">
				<span class="feature-number">02</span>
				<h3 class="feature-title">Autonomous Building</h3>
				<p class="feature-desc">The Ralph Loop executes one task per iteration with continuous backpressure for self-correction.</p>
			</div>
			<div class="feature feature-tertiary">
				<span class="feature-number">03</span>
				<h3 class="feature-title">Compounding Learnings</h3>
				<p class="feature-desc">Context persists across iterations. Patterns and fixes accumulate, making each run smarter.</p>
			</div>
		</section>
	</main>
</body>
</html>

<style>
	/* Landing page specific styles */
	.landing {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		background: var(--landing-bg, #0a0f0d);
		color: var(--landing-text, #e0f2e9);
		font-family: 'Outfit', sans-serif;
	}

	.landing-main {
		max-width: 1000px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	/* Hero section - asymmetric layout */
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		margin-bottom: 5rem;
		text-align: left;
	}

	.hero-content {
		position: relative;
		z-index: 1;
	}

	.hero-title {
		margin: 0 0 1.5rem 0;
		font-size: 3.5rem;
		font-weight: 700;
		font-family: 'JetBrains Mono', monospace;
		letter-spacing: -0.02em;
	}

	.hero-name {
		background: linear-gradient(135deg, var(--landing-accent, #00e5ff), var(--landing-accent-green, #00ff9f));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-tagline {
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--landing-muted, #6b8f7a);
		margin: 0 0 2.5rem 0;
		max-width: 28ch;
	}

	.hero-buttons {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	/* Hero visual element */
	.hero-visual {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 180px;
	}

	.hero-glyph {
		font-family: 'JetBrains Mono', monospace;
		font-size: 4rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		position: relative;
		z-index: 1;
	}

	.glyph-bracket {
		color: var(--landing-muted, #6b8f7a);
		opacity: 0.6;
	}

	.glyph-symbol {
		background: linear-gradient(135deg, var(--landing-accent, #00e5ff), var(--landing-accent-green, #00ff9f));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-orbit {
		position: absolute;
		width: 200px;
		height: 200px;
		border: 1px dashed rgba(0, 229, 255, 0.2);
		border-radius: 50%;
		transform: rotate(-15deg);
	}

	/* Buttons */
	.btn {
		display: inline-block;
		padding: 0.875rem 1.75rem;
		font-size: 1rem;
		font-weight: 500;
		text-decoration: none;
		border-radius: 6px;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn-primary {
		background: var(--landing-accent, #00e5ff);
		color: var(--landing-bg, #0a0f0d);
	}

	.btn-primary:hover {
		box-shadow: 0 4px 20px rgba(0, 229, 255, 0.4);
	}

	.btn-secondary {
		background: transparent;
		color: var(--landing-text, #e0f2e9);
		border: 1px solid var(--landing-muted, #6b8f7a);
	}

	.btn-secondary:hover {
		border-color: var(--landing-accent, #00e5ff);
		box-shadow: 0 4px 20px rgba(0, 229, 255, 0.2);
	}

	/* Features section - asymmetric grid */
	.features {
		display: grid;
		gap: 1.5rem;
	}

	.feature {
		padding: 1.5rem;
		border-radius: 8px;
		background: linear-gradient(
			135deg,
			rgba(0, 229, 255, 0.06) 0%,
			rgba(0, 255, 159, 0.03) 100%
		);
		border: 1px solid rgba(0, 229, 255, 0.15);
		box-shadow:
			0 4px 24px rgba(0, 0, 0, 0.25),
			inset 0 1px 0 rgba(255, 255, 255, 0.04);
		position: relative;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.feature:hover {
		transform: translateY(-3px);
		border-color: rgba(0, 229, 255, 0.3);
		box-shadow:
			0 8px 32px rgba(0, 0, 0, 0.35),
			0 0 20px rgba(0, 229, 255, 0.1),
			inset 0 1px 0 rgba(255, 255, 255, 0.06);
	}

	.feature-number {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		color: var(--landing-accent, #00e5ff);
		opacity: 0.5;
		position: absolute;
		top: 1rem;
		right: 1rem;
	}

	.feature-title {
		margin: 0 0 0.75rem 0;
		font-size: 1.125rem;
		font-weight: 600;
		font-family: 'JetBrains Mono', monospace;
		color: var(--landing-accent, #00e5ff);
	}

	.feature-desc {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: rgba(224, 242, 233, 0.85);
	}

	/* Primary feature - larger, more emphasis */
	.feature-primary {
		border-color: rgba(0, 229, 255, 0.25);
		background: linear-gradient(
			135deg,
			rgba(0, 229, 255, 0.1) 0%,
			rgba(0, 255, 159, 0.05) 100%
		);
		box-shadow:
			0 6px 32px rgba(0, 0, 0, 0.3),
			0 0 1px rgba(0, 229, 255, 0.3),
			inset 0 1px 0 rgba(255, 255, 255, 0.06);
	}

	.feature-primary:hover {
		border-color: rgba(0, 229, 255, 0.4);
		box-shadow:
			0 12px 48px rgba(0, 0, 0, 0.4),
			0 0 30px rgba(0, 229, 255, 0.15),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.feature-primary .feature-title {
		font-size: 1.25rem;
	}

	/* Tertiary feature - offset positioning */
	.feature-tertiary {
		margin-left: 0;
	}

	/* Responsive - desktop asymmetric layout */
	@media (min-width: 768px) {
		.landing-main {
			padding: 6rem 2rem;
		}

		/* Asymmetric hero grid */
		.hero {
			grid-template-columns: 1.4fr 1fr;
			align-items: center;
			gap: 4rem;
		}

		.hero-title {
			font-size: 4.5rem;
		}

		.hero-tagline {
			font-size: 1.375rem;
		}

		.hero-visual {
			min-height: 280px;
		}

		.hero-glyph {
			font-size: 6rem;
		}

		.hero-orbit {
			width: 280px;
			height: 280px;
		}

		/* Asymmetric feature grid - varied sizes */
		.features {
			grid-template-columns: 1.3fr 1fr;
			grid-template-rows: auto auto;
			gap: 1.5rem;
		}

		.feature-primary {
			grid-row: span 2;
			padding: 2rem;
			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.feature-primary .feature-desc {
			font-size: 1rem;
		}

		.feature-secondary {
			padding: 1.5rem;
		}

		.feature-tertiary {
			padding: 1.5rem;
			margin-left: 1rem;
		}
	}

	/* Large screens - more dramatic asymmetry */
	@media (min-width: 1024px) {
		.landing-main {
			padding: 8rem 2rem;
		}

		.hero {
			grid-template-columns: 1.5fr 1fr;
		}

		.hero-title {
			font-size: 5rem;
		}

		.features {
			grid-template-columns: 1.4fr 0.9fr;
		}

		.feature-tertiary {
			margin-left: 2rem;
		}
	}
</style>
