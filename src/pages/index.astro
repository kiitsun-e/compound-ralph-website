---
import '../styles/custom.css';

const title = 'Ralph Borg';
const description = 'Autonomous feature implementation combining rich planning with self-correcting code generation.';
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="landing">
	<main class="landing-main">
		<section class="hero">
			<h1 class="hero-title">
				<span class="hero-name">Ralph Borg</span>
			</h1>
			<p class="hero-tagline">
				Fire-and-forget feature implementation.<br />
				Plan rich. Build autonomous.
			</p>

			<div class="hero-buttons">
				<a href="/getting-started" class="btn btn-primary">Get Started</a>
				<a href="https://github.com/yourusername/ralph-borg" class="btn btn-secondary" target="_blank" rel="noopener">
					GitHub
				</a>
			</div>
		</section>

		<section class="features">
			<div class="feature">
				<h3 class="feature-title">Rich Planning</h3>
				<p class="feature-desc">Human-guided specs with parallel research agents. Every feature starts with deep understanding.</p>
			</div>
			<div class="feature">
				<h3 class="feature-title">Autonomous Building</h3>
				<p class="feature-desc">The Ralph Loop executes one task per iteration with continuous backpressure for self-correction.</p>
			</div>
			<div class="feature">
				<h3 class="feature-title">Compounding Learnings</h3>
				<p class="feature-desc">Context persists across iterations. Patterns and fixes accumulate, making each run smarter.</p>
			</div>
		</section>
	</main>
</body>
</html>

<style>
	/* Landing page specific styles */
	.landing {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		background: var(--landing-bg, #0a0f0d);
		color: var(--landing-text, #e0f2e9);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}

	.landing-main {
		max-width: 800px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	/* Hero section */
	.hero {
		text-align: center;
		margin-bottom: 5rem;
	}

	.hero-title {
		margin: 0 0 1.5rem 0;
		font-size: 3.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.hero-name {
		background: linear-gradient(135deg, var(--landing-accent, #00e5ff), var(--landing-accent-green, #00ff9f));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-tagline {
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--landing-muted, #6b8f7a);
		margin: 0 0 2.5rem 0;
	}

	.hero-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Buttons */
	.btn {
		display: inline-block;
		padding: 0.875rem 1.75rem;
		font-size: 1rem;
		font-weight: 500;
		text-decoration: none;
		border-radius: 6px;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn-primary {
		background: var(--landing-accent, #00e5ff);
		color: var(--landing-bg, #0a0f0d);
	}

	.btn-primary:hover {
		box-shadow: 0 4px 20px rgba(0, 229, 255, 0.4);
	}

	.btn-secondary {
		background: transparent;
		color: var(--landing-text, #e0f2e9);
		border: 1px solid var(--landing-muted, #6b8f7a);
	}

	.btn-secondary:hover {
		border-color: var(--landing-accent, #00e5ff);
		box-shadow: 0 4px 20px rgba(0, 229, 255, 0.2);
	}

	/* Features section */
	.features {
		display: grid;
		gap: 2rem;
	}

	.feature {
		padding: 1.5rem;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
	}

	.feature-title {
		margin: 0 0 0.75rem 0;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--landing-accent, #00e5ff);
	}

	.feature-desc {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--landing-muted, #6b8f7a);
	}

	/* Responsive */
	@media (min-width: 640px) {
		.landing-main {
			padding: 6rem 2rem;
		}

		.hero-title {
			font-size: 4.5rem;
		}

		.hero-tagline {
			font-size: 1.375rem;
		}

		.features {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
